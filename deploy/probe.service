[Unit]
Description=Bangumi Status Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bangumi-status
EnvironmentFile=/etc/bangumi-status/probe.env
ExecStart=/opt/bangumi-status/probe
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
